GEMINI_API_KEYS=
GLOBAL_LLM_MODEL=gemini-3.8-flash
TOTAL_ACCOUNT_BALANCE=10000
MAX_RISK_PER_TRADE_PERCENT=1.5
MAX_LEVERAGE=10
HOLD_SECONDS=2700
TAKER_FEE=0.0004
MAX_QUOTE_GAP_SECONDS=10
DB_PATH=quant_sentinel.db
